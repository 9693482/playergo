# PlayerGO environment template
# Copy this file to .env.dev / .env.staging / .env.prod and fill real values.
# These files are gitignored; NEVER commit real keys.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe (leave empty until keys are provided)
STRIPE_PUBLISHABLE_KEY=

# Firebase (leave empty until project is created)
FIREBASE_PROJECT_ID=

# Google Maps (leave empty until key is provided)
MAPS_API_KEY=
